DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=splitpay
DB_HOST=localhost
DB_PORT=5432

# Публикация портов на локальном компьютере (docker-compose.local.yml).
LOCAL_BIND_ADDR=127.0.0.1
PORT=8080
REDIS_PORT=6379

REDIS_IMAGE=redis:8-alpine
# Адрес для запуска Go в WSL. В контейнер API передаётся redis:6379.
REDIS_ADDR=localhost:6379

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=1m

JWT_SECRET=supersecret_for_local_dev

DATABASE_URL=postgres://postgres:secretpassword@localhost:5432/splitpay?sslmode=disable
