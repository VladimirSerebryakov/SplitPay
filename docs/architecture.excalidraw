    {
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 29246176,
      "version": 25,
      "versionNonce": 769858719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793105805313,
      "created": 1793047320323,
      "link": null,
      "locked": false,
      "id": "Jj-45uur3WXuhmlEwZ6vP",
      "type": "text",
      "x": -399.2955322265625,
      "y": 157,
      "width": 476.5915222167969,
      "height": 140,
      "strokeColor": "#1e1e1e",
      "roundness": null,
      "text": "1. signIn - access (15 мин) + refresh (30 дней)\n2. Каждый запрос: Authorization: Bearer <access>\n3. access истёк - POST /auth/refresh\n   новая пара токенов (rotation), старый refresh отзывается\n\nОба токена — в теле запроса и ответа (фронтенда нет)\nБД: refresh_tokens",
      "originalText": "1. signIn - access (15 мин) + refresh (30 дней)\n2. Каждый запрос: Authorization: Bearer <access>\n3. access истёк - POST /auth/refresh\n   новая пара токенов (rotation), старый refresh отзывается\n\nОба токена — в теле запроса и ответа (фронтенда нет)\nБД: refresh_tokens",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "ak"
    },
