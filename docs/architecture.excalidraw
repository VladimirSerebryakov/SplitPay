    {
      "id": "LJhpi8d0xJMAaUPq1NM88",
      "type": "text",
      "x": 527.3739097332244,
      "y": 1154.2000680678113,
      "width": 380.81573486328125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04",
      "roundness": null,
      "seed": 2127523787,
      "version": 30,
      "versionNonce": 1716949733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793120266078,
      "created": 1793047973066,
      "link": null,
      "locked": false,
      "text": "Отдельный процесс, бесконечный цикл:\n1. раз в N мс берёт пачку из outbox\n    (status = new, FOR UPDATE SKIP LOCKED)\n2. публикует в Kafka, key = group_id\n3. status = sent. Kafka недоступна -\n    retry с backoff бесконечно, не сдаёмся\n    failed — только если событие нельзя\n    отправить в принципе\nГарантия: at-least-once -\nконсьюмеры должны быть идемпотентны",
      "originalText": "Отдельный процесс, бесконечный цикл:\n1. раз в N мс берёт пачку из outbox\n    (status = new, FOR UPDATE SKIP LOCKED)\n2. публикует в Kafka, key = group_id\n3. status = sent. Kafka недоступна -\n    retry с backoff бесконечно, не сдаёмся\n    failed — только если событие нельзя\n    отправить в принципе\nГарантия: at-least-once -\nконсьюмеры должны быть идемпотентны",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
